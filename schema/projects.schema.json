{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobeUX project collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataKind", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataKind": { "const": "demo", "description": "This starter contains illustrative projects only." },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/definitions/project" }
    }
  },
  "definitions": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "lat", "lng", "importance", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90, "description": "WGS84 latitude in decimal degrees, north positive." },
        "lng": { "type": "number", "minimum": -180, "maximum": 180, "description": "WGS84 longitude in decimal degrees, east positive." },
        "importance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Dimensionless display weight, rendered in globe-radius units. Not a measured value or quality score." },
        "status": { "enum": ["active", "inactive"] }
      }
    }
  }
}
